PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATA_DIR=.data
# Production needs HTTPS, a TLS reverse proxy and the launch gates in docs/engineering.
NODE_ENV=development
# .env is loaded by server/index.ts. Existing environment values take precedence.
# Set APP_ORIGIN=http://127.0.0.1:3001 for the combined local built-client server.
# NODE_ENV=production requires an explicit HTTPS APP_ORIGIN.
# Optional email delivery. Set a verified sender and real SMTP credentials to enable
# password recovery and opted-in reminders while the browser is closed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Port 465 uses TLS immediately; other ports require STARTTLS. No insecure fallback.
